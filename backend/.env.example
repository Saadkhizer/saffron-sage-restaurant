# --- Server ---
PORT=4500
# Comma-separated list of allowed origins for CORS (the frontend dev URL)
CLIENT_ORIGIN=http://localhost:5173

# --- Auth ---
# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Owner / admin login ---
# Required to create or update the restaurant owner account. Change
# OWNER_PASSWORD (and redeploy) any time you want to rotate the login.
OWNER_EMAIL=owner@yourdomain.com
OWNER_PASSWORD=change-me-to-a-strong-password

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Leave blank to disable the "Continue with Google" button.
GOOGLE_CLIENT_ID=

# --- Branding / display (served to the frontend via /api/config) ---
RESTAURANT_NAME=Saffron & Sage
CURRENCY_CODE=USD
CURRENCY_SYMBOL=$
DELIVERY_FEE_CENTS=299
